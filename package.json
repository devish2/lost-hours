{
  "name": "lost-hours",
  "version": "0.1.0",
  "private": true,
  "description": "Lost Hours - privacy-first digital attention tracking",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "mobile:start": "pnpm --filter lost-hours-mobile start",
